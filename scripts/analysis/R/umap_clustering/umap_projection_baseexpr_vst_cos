library(dplyr)
library(tidyr)
library(ggplot2)
library(pheatmap)
library(umap)
library(stringr)
library(RColorBrewer)
library(proxy)
library(stats)
library(DESeq2)

# -------------------------------
# Load and prepare input
# -------------------------------
ignore_list <- c("DiFia", "DiFib", "DiFic")
expr_metric <- "vst"  # or "lognorm"
min_presence <- 12

rds_files <- list.files(pattern = "^dds_(.*)\\.rds$")
if (length(rds_files) == 0) stop("No dds_*.rds files found.")

extract_group <- function(filename) {
  str_match(filename, "^dds_(.*)\\.rds$")[, 2]
}

summarize_base_expression <- function(dds, metric = c("vst","lognorm")) {
  metric <- match.arg(metric)
  keep <- colData(dds)$condition == "Input"
  if (!any(keep)) return(NULL)
  dds_in <- dds[, keep, drop=FALSE]
  
  if (metric == "vst") {
    vs <- varianceStabilizingTransformation(dds_in, blind = TRUE)
    X  <- assay(vs)
  } else {
    X <- log2(counts(dds_in, normalized = TRUE) + 1)
  }
  
  base_vec <- rowMeans(X, na.rm = TRUE)
  names(base_vec) <- rownames(dds_in)
  return(base_vec)
}

group_vectors <- list()
transcript_sets <- list()

for (f in rds_files) {
  group <- extract_group(f)
  
  if (group %in% ignore_list) {
    message("⏭️ Skipping ignored group: ", group)
    next
  }
  
  dds <- tryCatch(readRDS(f), error = function(e) NULL)
  if (is.null(dds)) {
    warning(paste("Skipping", f, "- could not read RDS"))
    next
  }
  
  vec <- summarize_base_expression(dds, metric = expr_metric)
  if (is.null(vec) || !any(is.finite(vec))) {
    warning(paste("Skipping", group, "- no valid Input samples"))
    next
  }
  
  group_vectors[[group]]  <- vec
  transcript_sets[[group]] <- names(vec)
}

if (length(group_vectors) < 3) stop("Not enough valid groups.")

# -------------------------------
# Construct group matrix
# -------------------------------
all_transcripts <- Reduce(union, transcript_sets)
group_matrix <- do.call(rbind, lapply(group_vectors, function(vec) {
  out <- rep(NA, length(all_transcripts))
  names(out) <- all_transcripts
  out[names(vec)] <- vec
  return(out)
}))
rownames(group_matrix) <- names(group_vectors)
colnames(group_matrix) <- all_transcripts

# Filter low-coverage transcripts
keep_cols <- colSums(!is.na(group_matrix)) >= min_presence
group_matrix <- group_matrix[, keep_cols]

# -------------------------------
# Batch metadata
# -------------------------------
batch_map <- c(
  "U937"  = "B1",
  "Jurkat"= "B1",
  "HeLa"  = "B2",
  "AML3"  = "B2"
)
batch <- factor(ifelse(rownames(group_matrix) %in% names(batch_map),
                       batch_map[rownames(group_matrix)], "B0"),
                levels = c("B0","B1","B2"))

# -------------------------------
# Residualize per gene
# -------------------------------
residualize_batch <- function(M, batch_factor, weights_mat = NULL) {
  M_adj <- M
  for (j in seq_len(ncol(M))) {
    y  <- M[, j]
    ok <- is.finite(y) & !is.na(batch_factor)
    if (sum(ok) >= 3 && nlevels(droplevels(batch_factor[ok])) >= 2) {
      if (!is.null(weights_mat)) {
        w <- weights_mat[, j]
        w_ok <- ifelse(is.finite(w), w, NA_real_)
        fit <- lm(y[ok] ~ batch_factor[ok], weights = w_ok[ok])
      } else {
        fit <- lm(y[ok] ~ batch_factor[ok])
      }
      r <- rep(NA_real_, length(y))
      r[ok] <- resid(fit) + mean(y[ok], na.rm = TRUE)
      M_adj[, j] <- r
    } else {
      M_adj[, j] <- y
    }
  }
  M_adj
}
group_matrix <- residualize_batch(group_matrix, batch)

# -------------------------------
# Clean and scale matrix
# -------------------------------
cm <- colMeans(group_matrix, na.rm = TRUE)
cs <- apply(group_matrix, 2, sd, na.rm = TRUE)
cs[!is.finite(cs) | cs == 0] <- 1
group_matrix_scaled <- sweep(sweep(group_matrix, 2, cm, "-"), 2, cs, "/")

# -------------------------------
# Pairwise-complete cosine + MDS
# -------------------------------
cosine_pairwise <- function(A) {
  n <- nrow(A)
  D <- matrix(0, n, n)
  for (i in seq_len(n)) {
    for (j in i:n) {
      ok <- is.finite(A[i, ]) & is.finite(A[j, ])
      if (!any(ok)) {
        d <- 1
      } else {
        ai <- A[i, ok]; aj <- A[j, ok]
        num <- sum(ai * aj)
        denom <- sqrt(sum(ai^2)) * sqrt(sum(aj^2))
        d <- if (denom == 0) 1 else 1 - (num / denom)
      }
      D[i, j] <- D[j, i] <- d
    }
  }
  as.dist(D)
}
cosine_dist <- cosine_pairwise(group_matrix_scaled)
mds_result <- cmdscale(cosine_dist, k = 9)

# -------------------------------
# UMAP
# -------------------------------
umap_config <- umap.defaults
umap_config$min_dist <- 0.17
umap_config$n_neighbors <- min(7, nrow(group_matrix_scaled) - 1)
set.seed(42)
umap_result <- umap(mds_result, config = umap_config)

umap_df <- as.data.frame(umap_result$layout)
colnames(umap_df) <- c("UMAP1", "UMAP2")
umap_df$group <- rownames(group_matrix_scaled)

# -------------------------------
# Lineage (binary)
# -------------------------------
hematopoietic <- c("AML2", "AML3", "Molm13", "Jurkat", "Jeko1", "Nalm6", "U937")
umap_df$lineage <- ifelse(umap_df$group %in% hematopoietic, "Hematopoietic", "Non-hematopoietic")
umap_df$lineage <- factor(umap_df$lineage, levels = c("Hematopoietic", "Non-hematopoietic"))

# -------------------------------
# Convex hulls for PRIOR LINEAGE groups
# (reuse the former cluster palette for hull fills)
# -------------------------------
get_hulls <- function(df, cluster_col, x_col, y_col) {
  df %>%
    group_by(!!sym(cluster_col)) %>%
    group_split() %>%
    lapply(function(group) {
      if (nrow(group) >= 3) {
        hull_idx <- chull(group[[x_col]], group[[y_col]])
        group[hull_idx, ]
      } else {
        NULL
      }
    }) %>%
    bind_rows()
}
hull_df <- get_hulls(umap_df, "lineage", "UMAP1", "UMAP2")

# Hull colors = previous cluster colors
hull_colors <- c(
  "Hematopoietic"     = "#F7A1B2",
  "Non-hematopoietic" = "#BCE8DD"
)

# Point colors for lineage
lineage_colors <- c(
  "Hematopoietic"     = "#E01A4F",
  "Non-hematopoietic" = "#7DCFB6"
)

# -------------------------------
# UMAP Plot (no Fisher subtitle)
# -------------------------------
title_metric <- if (expr_metric == "vst") "Input VST" else "Input log2(norm+1)"

umap_plot <- ggplot(umap_df, aes(x = UMAP1, y = UMAP2)) +
  geom_polygon(
    data = hull_df,
    aes(x = UMAP1, y = UMAP2, fill = lineage, group = lineage),
    alpha = 0.2,
    color = NA,
    inherit.aes = FALSE,
    show.legend = FALSE
  ) +
  geom_point(aes(color = lineage), size = 3) +
  geom_text(
    aes(label = group),
    color = "black",
    vjust = 1.8,
    size = 3,
    show.legend = FALSE
  ) +
  scale_fill_manual(values = hull_colors) +
  scale_color_manual(values = lineage_colors, name = "Lineage") +
  coord_cartesian(clip = "off") +
  labs(
    title = paste0("UMAP of Cell Lines (", title_metric, ", Cosine)"),
    color = "Lineage",
    fill = "Lineage"
  ) +
  theme_minimal(base_size = 10) +
  theme(
    panel.grid   = element_blank(),
    axis.line    = element_line(color = "black"),
    axis.ticks   = element_line(color = "black"),
    plot.title   = element_text(face = "bold", size = 10),
    axis.title   = element_text(size = 9),
    axis.text    = element_text(size = 8),
    legend.title = element_text(face = "bold", size = 9),
    legend.text  = element_text(size = 8)
  )

ggsave(paste0("umap_cluster_baseexpr_", expr_metric, "_cosine.pdf"),
       plot = umap_plot, width = 4, height = 3)

# -------------------------------
# Heatmap
# -------------------------------
pdf(paste0("heatmap_baseexpr_", expr_metric, "_cosine.pdf"), width = 6, height = 6)

d_rows <- cosine_pairwise(group_matrix_scaled)
d_cols <- cosine_pairwise(t(group_matrix_scaled))

Dr <- as.matrix(d_rows); Dc <- as.matrix(d_cols)
bad_r <- which(!is.finite(rowSums(Dr)))
bad_c <- which(!is.finite(rowSums(Dc)))
if (length(bad_r) > 0 || length(bad_c) > 0) {
  keep_r <- setdiff(seq_len(nrow(group_matrix_scaled)), bad_r)
  keep_c <- setdiff(seq_len(ncol(group_matrix_scaled)), bad_c)
  group_matrix_scaled <- group_matrix_scaled[keep_r, keep_c, drop = FALSE]
  d_rows <- as.dist(Dr[keep_r, keep_r, drop = FALSE])
  d_cols <- as.dist(Dc[keep_c, keep_c, drop = FALSE])
}

pheatmap(group_matrix_scaled,
         cluster_rows = TRUE,
         cluster_cols = TRUE,
         clustering_distance_rows = d_rows,
         clustering_distance_cols = d_cols,
         na_col = "#EEEEEE",
         main = paste("Heatmap of Base Expression (", title_metric, ")", sep=""),
         show_rownames = TRUE,
         show_colnames = FALSE)
dev.off()

# -------------------------------
# Save coordinates
# -------------------------------
write.csv(umap_df, paste0("umap_coordinates_baseexpr_", expr_metric, "_cosine.csv"), row.names = FALSE)
